    "## 2. Overlap check (8-gram) — anti-contaminação\n",
    "\n",
    "Antes de treinar: garante que NENHUM exemplo de treino aparece nos benchmarks (Decision Index frozen, JevBench, EnvBench held-out). O próprio index invalida quem treina na prova."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Célula 3 — overlap check 8-gram contra listas de exclusão\n",
    "def grams8(text):\n",
    "    toks = text.lower().split()\n",
    "    return {' '.join(toks[i:i+8]) for i in range(max(0, len(toks)-7))}\n",
    "\n",
    "# TODO: preencher com os textos dos benchmarks (baixar frozen suite p/ checagem local,\n",
    "# SEM incluir no treino). Aqui o esqueleto:\n",
    "FORBIDDEN = set()  # unions de 8-grams dos benchmarks\n",
    "# for f in ['di_frozen_texts.txt', 'jevbench_texts.txt', 'envbench_heldout.txt']:\n",
    "#     FORBIDDEN |= {g for line in open(f) for g in grams8(line)}\n",
    "\n",
    "import json\n",
    "bad = 0\n",
    "for line in open('/content/work/multi_typed.jsonl'):\n",
    "    ex = json.loads(line)\n",
    "    if grams8(ex['prompt']) & FORBIDDEN:\n",
    "        bad += 1\n",
    "print(f'exemplos contaminados: {bad} (tem que ser 0)')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
